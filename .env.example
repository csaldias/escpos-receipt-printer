# Printer Type
PRINTER_TYPE=EPSON

# USB Configuration in hexadecimal format (e.g. 0x811e)
PRINTER_VENDOR_ID=
PRINTER_PRODUCT_ID=

# Network Configuration (uncomment for network printers)
# PRINTER_NETWORK_IP=
# PRINTER_NETWORK_PORT=9100

# Message API: named bearer tokens for POST /print-message, one per group of machines,
# as name:token pairs separated by commas (generate each with: openssl rand -hex 32)
PRINT_API_TOKENS=home:,external:
# Maximum messages printed per hour
MESSAGE_RATE_LIMIT=10
